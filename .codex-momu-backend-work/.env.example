NODE_ENV=production
PORT=3000

# Public Momu backend URL used when generating stable uploaded-file URLs.
MOMU_PUBLIC_API_BASE_URL=https://api.mo-cms.com
MOMU_QR_BASE_URL=https://api.mo-cms.com
MOMU_QR_LINK_TTL_SECONDS=900
MOMU_QR_RATE_LIMIT=300
MOMU_ASSET_PUBLIC_BASE_URL=

# Browser origins allowed to call this API. Mobile/native requests have no Origin header.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to the number of trusted reverse proxies in front of Node.
TRUST_PROXY_HOPS=0

GLOBAL_RATE_LIMIT=1000

# Authentication and password recovery. Generate a random value with at least
# 32 characters and keep it stable across restarts.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL=12h
PASSWORD_BCRYPT_ROUNDS=12
TEMP_PASSWORD_RATE_WINDOW_MS=900000
TEMP_PASSWORD_ACCOUNT_RATE_LIMIT=3
TEMP_PASSWORD_IP_RATE_LIMIT=20
TEMP_PASSWORD_MIN_RESPONSE_MS=400
TEMP_PASSWORD_WORKER_INTERVAL_MS=5000
TEMP_PASSWORD_MAIL_MAX_ATTEMPTS=3

# SMTP is required before temporary-password delivery can succeed. A failed
# delivery leaves the existing password unchanged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="O'ARCH <no-reply@mo-cms.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
MOMU_LOGIN_URL=https://mo-cms.com

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_CONNECTION_LIMIT=10

AWS_REGION=
# Production uses the EC2 instance role. Static AWS keys are not required.
AWS_S3_BUCKET_NAME=
AWS_S3_MOMU_ASSET_PREFIX=momu/assets
AWS_S3_HERE_MY_PHOTO_PREFIX=momu/here-my-photo
AWS_S3_VIVID_FRIENDS_PREFIX=momu/vivid-friends

# Optional background schedule polling interval.
MOMU_SCHEDULE_POLL_INTERVAL_MS=
